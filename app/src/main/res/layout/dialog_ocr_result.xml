<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="2dp"
        android:paddingRight="2dp">

        <TextView
            android:id="@+id/tvOcrHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_field"
            android:padding="12dp"
            android:textColor="@color/text_sub"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvOcrBrand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_field"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView style="@style/FormLabel" android:text="货品编码" />
        <EditText
            android:id="@+id/etOcrGoods"
            style="@style/FormInput"
            android:hint="识别不到可手填"
            android:importantForAutofill="no"
            android:inputType="text" />

        <TextView style="@style/FormLabel" android:text="OE码" />
        <EditText
            android:id="@+id/etOcrOe"
            style="@style/FormInput"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:hint="多个用 / 分隔"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:minLines="2" />

        <TextView style="@style/FormLabel" android:text="车型" />
        <EditText
            android:id="@+id/etOcrCar"
            style="@style/FormInput"
            android:importantForAutofill="no"
            android:inputType="text" />

        <TextView style="@style/FormLabel" android:text="规格" />
        <EditText
            android:id="@+id/etOcrSpec"
            style="@style/FormInput"
            android:importantForAutofill="no"
            android:inputType="text" />

        <TextView
            android:id="@+id/btnOcrRaw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_field"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="📄 查看识别到的全部文字"
            android:textColor="@color/text_sub"
            android:textSize="12.5sp" />
    </LinearLayout>
</ScrollView>
