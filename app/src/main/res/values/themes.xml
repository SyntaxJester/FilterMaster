<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FilterMaster" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_deep</item>
        <item name="android:statusBarColor">#2456E8</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="FormLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">7dp</item>
        <item name="android:textColor">@color/text_sub</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FormInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textColorHint">#A6AFC0</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
